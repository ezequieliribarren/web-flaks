{
  "name": "flaks-web",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio de FLAKS — agencia digital (Express + EJS)",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch-path=server.js --watch-path=routes --watch-path=lib --watch-path=data server.js",
    "postinstall": "node scripts/vendor.js",
    "capture": "node scripts/capture.mjs",
    "og": "node scripts/og.mjs",
    "qa:e2e": "node scripts/qa/e2e.mjs",
    "qa:a11y": "node scripts/qa/a11y.mjs",
    "qa:lh": "node scripts/qa/lh.mjs / /landing-page /sitio-web /tienda-digital",
    "capture:social": "node scripts/capture-social.mjs"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "dotenv": "^18.0.4",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.7.0",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "lenis": "^1.3.26",
    "nodemailer": "^10.0.12"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "sharp": "^0.35.5"
  }
}
