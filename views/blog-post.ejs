<article class="simple-page blog-post" data-article="<%= post.slug %>" data-article-service="<%= post.service %>">
  <div class="glow" style="width:55vw;height:55vw;right:-25vw;top:-22vw" aria-hidden="true"></div>
  <div class="container blog-wrap">
    <nav class="crumbs" aria-label="Migas de pan"><ol><li><a href="/">Inicio</a></li><li><a href="/blog">Blog</a></li><li aria-current="page"><%= serviceName(post.service) %></li></ol></nav>
    <% if (draft) { %><p class="blog-draft" role="note">Borrador: no está publicado ni indexado. <%= post.draftNote || '' %></p><% } %>

    <header class="blog-head">
      <p class="eyebrow"><%= serviceName(post.service) %></p>
      <h1 class="blog-title"><%= post.title %></h1>
      <p class="blog-byline">Por el equipo de FLAKS · Actualizado el <time datetime="<%= post.updated %>"><%= fmtDate(post.updated) %></time> · <%= post.readMinutes %> min de lectura</p>
    </header>

    <aside class="blog-answer" aria-labelledby="answer-title">
      <h2 id="answer-title">Respuesta rápida</h2>
      <p><%- md(post.answer) %></p>
    </aside>

    <% if (post.intro) { %><p class="blog-intro"><%- md(post.intro) %></p><% } %>

    <nav class="blog-toc" aria-labelledby="toc-title">
      <h2 id="toc-title">En esta guía</h2>
      <ol>
        <% post.sections.forEach(function (s, i) { %><li><a href="#<%= s.id %>"><%= s.h2 %></a></li><% }) %>
        <% if (post.faq && post.faq.length) { %><li><a href="#preguntas">Preguntas frecuentes</a></li><% } %>
      </ol>
    </nav>

    <div class="blog-body">
      <% post.sections.forEach(function (s, i) { %>
      <section class="blog-sec" id="<%= s.id %>" aria-labelledby="<%= s.id %>-t">
        <h2 id="<%= s.id %>-t"><%= s.h2 %></h2>
        <% s.blocks.forEach(function (b) { %>
          <% if (typeof b === 'string') { %><p><%- md(b) %></p>
          <% } else if (b.h3) { %><h3><%= b.h3 %></h3>
          <% } else if (b.ul) { %><ul><% b.ul.forEach(function (li) { %><li><%- md(li) %></li><% }) %></ul>
          <% } else if (b.ol) { %><ol><% b.ol.forEach(function (li) { %><li><%- md(li) %></li><% }) %></ol>
          <% } else if (b.tip) { %><p class="blog-tip"><%- md(b.tip) %></p>
          <% } else if (b.table) { %><div class="blog-table" tabindex="0" role="region" aria-label="<%= b.table.caption || 'Tabla comparativa' %>"><table>
            <caption class="sr-only"><%= b.table.caption || 'Tabla comparativa' %></caption>
            <thead><tr><% b.table.head.forEach(function (h) { %><th scope="col"><%= h %></th><% }) %></tr></thead>
            <tbody><% b.table.rows.forEach(function (r) { %><tr><% r.forEach(function (c, ci) { %><% if (ci === 0) { %><th scope="row"><%- md(c) %></th><% } else { %><td><%- md(c) %></td><% } %><% }) %></tr><% }) %></tbody>
          </table></div>
          <% } %>
        <% }) %>
      </section>
      <% if (i === 1) { %>
      <aside class="blog-cta-inline" aria-label="Consulta">
        <p><strong><%= post.ctaTitle || '¿Querés que lo hagamos por vos?' %></strong> <%= post.ctaLine || 'Contanos tu caso y te respondemos en el día.' %></p>
        <a class="btn btn--primary btn--sm" href="<%= wa(waTextMid) %>" target="_blank" rel="noopener" data-wa="blog-<%= post.slug %>-mid"><%- include('partials/icon', { name: 'whatsapp' }) %>Consultar por WhatsApp<span class="sr-only"> (abre en una pestaña nueva)</span></a>
      </aside>
      <% } %>
      <% }) %>

      <% if (post.faq && post.faq.length) { %>
      <section class="blog-sec" id="preguntas" aria-labelledby="preguntas-t">
        <h2 id="preguntas-t">Preguntas frecuentes</h2>
        <div class="faq">
          <% post.faq.forEach(function (f) { %><details class="faq__item">
            <summary><h3><%= f.q %></h3><%- include('partials/icon', { name: 'plus' }) %></summary>
            <p class="faq__a"><%- md(f.a) %></p>
          </details><% }) %>
        </div>
      </section>
      <% } %>

      <% if (post.sources && post.sources.length) { %>
      <section class="blog-sec blog-sources" aria-labelledby="fuentes-t">
        <h2 id="fuentes-t">Fuentes y lecturas recomendadas</h2>
        <ul><% post.sources.forEach(function (s) { %><li><a href="<%= s.url %>" target="_blank" rel="noopener"><%= s.label %></a></li><% }) %></ul>
      </section>
      <% } %>
    </div>

    <aside class="blog-final" aria-labelledby="final-t">
      <h2 id="final-t"><%= post.finalTitle || '¿Hablamos de tu proyecto?' %></h2>
      <p><%= post.finalText || 'Te contamos qué conviene para tu caso, cuánto lleva y cómo lo medimos. Sin compromiso.' %></p>
      <div class="blog-final__actions">
        <a class="btn btn--primary" href="<%= wa(waTextMid) %>" target="_blank" rel="noopener" data-wa="blog-<%= post.slug %>-end"><%- include('partials/icon', { name: 'whatsapp' }) %>Hablar por WhatsApp<span class="sr-only"> (abre en una pestaña nueva)</span></a>
        <% if (svc) { %><a class="btn btn--ghost" href="/<%= svc.slug %>">Ver el servicio de <%= svc.name.toLowerCase() %></a><% } %>
      </div>
    </aside>

    <% if (related.length) { %>
    <section class="blog-related" aria-labelledby="rel-t">
      <h2 id="rel-t">Seguí leyendo</h2>
      <ul class="blog-cards blog-cards--sm" role="list">
        <% related.forEach(function (p) { %><li><a class="blog-card" href="/blog/<%= p.slug %>"><span class="blog-card__meta"><span class="blog-tag"><%= serviceName(p.service) %></span></span><span class="blog-card__title"><%= p.title %></span></a></li><% }) %>
      </ul>
    </section>
    <% } %>
  </div>
</article>
