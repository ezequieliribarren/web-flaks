# Servidor
PORT=3000
NODE_ENV=production
# URL canónica, sin barra final. Define también si se fuerza www o no.
SITE_URL=https://flaks.com.ar
# Redirección de host: "apex" (www -> flaks.com.ar), "www" (flaks.com.ar -> www) o vacío (no redirige)
CANONICAL_HOST=apex

# Email (formulario de contacto)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@flaks.com.ar
SMTP_PASS=
MAIL_TO=info@flaks.com.ar
MAIL_FROM="FLAKS Web <info@flaks.com.ar>"

# Contacto y tracking
WHATSAPP_NUMBER=5491157455803
GTM_ID=GTM-TWHGP8NC
# Microsoft Clarity (opcional): ID del proyecto. Vacío = no se carga.
CLARITY_ID=
# Link de "Agendar llamada". Vacío = el de data/site.json (Calendly de FLAKS).
BOOKING_URL=https://calendly.com/agendar-reunion-flaks/30min
